{
  "expo": {
    "name": "stockly",
    "slug": "stockly-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stockly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.stockly.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Autoriser stockly à accéder à la caméra pour scanner les QR codes d'enregistrement des TPE.",
        "NSLocationWhenInUseUsageDescription": "Autoriser stockly à accéder à votre localisation pour enregistrer la position du TPE et faciliter son suivi.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Autoriser stockly à accéder à votre localisation pour enregistrer la position du TPE."
      },
      "entitlements": {
        "com": {
          "apple": {
            "developer": {
              "networking": {
                "wifi-info": true
              }
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#D85A30"
      },
      "package": "com.stockly.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.app/"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser stockly à accéder à la caméra pour scanner les QR codes d'enregistrement des TPE."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser stockly à accéder à votre localisation pour enregistrer la position du TPE et faciliter son suivi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7c94c735-90d6-4252-a3c8-736389e1cd8e"
      }
    },
    "owner": "labo-progiciel",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7c94c735-90d6-4252-a3c8-736389e1cd8e"
    }
  }
}
